<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.DetailActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero -->
            <ImageView
                android:id="@+id/thumbnailImageView"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:src="@drawable/ic_launcher_background"
                android:scaleType="centerCrop"/>

            <!-- Informacion basica -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Game title"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:paddingBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Genre"
                        android:textColor="@color/md_theme_onTertiary"
                        android:enabled="false"
                        app:ensureMinTouchTargetSize="false"
                        app:chipBackgroundColor="@color/md_theme_tertiary"/>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                    <ImageView
                        android:id="@+id/platformImageView"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_platform_pc_windows"
                        app:tint="@color/md_theme_primary"/>

                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_margin="16dp"/>

            <!--Descripcion-->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Description"/>

                <TextView
                    android:id="@+id/descriptionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lorem Ipsum"/>


            </LinearLayout>


            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_margin="16dp"/>

            <!--Imagenes-->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Imagenes"
                />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/screenshotsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="128dp"
                tools:listitem="@layout/item_screenshot"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:clipToPadding="false"/>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_margin="16dp"/>

            <!--Requisitos del sistema-->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="System requirements" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="OS" />

                <TextView
                    android:id="@+id/systemRequirementsOsTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Windows 11" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Processor" />

                <TextView
                    android:id="@+id/systemRequirementsProcessorTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Intel Core i3" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Memory" />

                <TextView
                    android:id="@+id/systemRequirementsMemoryTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="6 GB RAM" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Graphics" />

                <TextView
                    android:id="@+id/systemRequirementsGraphicsTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NVIDIA GeForce GTX 600 series, AMD Radeon HD 7000 series" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Storage" />

                <TextView
                    android:id="@+id/systemRequirementsStorageTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="50 Gb" />

            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="64dp"/>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="32dp"
        android:paddingVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/playButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Play"/>

        <Space
            android:layout_width="16dp"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/shareButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_search"/>


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>